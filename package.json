{
  "name": "coa-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Assistente operacional do COA em modo seguro de simulacao.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "analyze:workbooks": "tsx tools/analyze-workbooks.ts",
    "excel:prepare-dev": "tsx apps/excel-agent/src/prepare-dev.ts",
    "excel:agent": "tsx apps/excel-agent/src/index.ts",
    "test:excel": "vitest run --config vitest.excel.config.ts",
    "test:integration": "tsx --env-file=.env tools/run-integration-tests.ts",
    "setup": "tsx tools/setup-dev.ts",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "stop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "status:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-local.ps1",
    "dev": "concurrently --kill-others-on-fail --names API,WEB,EXCEL,WHATSAPP --prefix-colors blue,green,magenta,yellow \"npm run dev --workspace @coa-bot/api\" \"npm run dev --workspace @coa-bot/web\" \"npm run dev --workspace @coa-bot/excel-agent\" \"npm run dev --workspace @coa-bot/whatsapp\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:rebuild-operational-projections": "tsx tools/rebuild-operational-projections.ts",
    "db:seed": "tsx packages/database/prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
